# Copy this file to /etc/conduit/.env and fill in real values.
# docker compose picks it up automatically (do NOT commit the real one).

# Cloudflare API token with Zone:DNS:Edit, scoped to your conduit zone.
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token.
CONDUIT_DNS_PROVIDER_CREDS=your-cloudflare-api-token-here
