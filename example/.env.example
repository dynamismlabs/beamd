# Copy this file to /etc/beamd/.env and fill in real values.
# docker compose picks it up automatically (do NOT commit the real one).

# Cloudflare API token with Zone:DNS:Edit, scoped to your beam zone.
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token.
BEAMD_DNS_PROVIDER_CREDS=your-cloudflare-api-token-here

# Edge yamux per-stream receive window in bytes (default 4 MiB = 4194304).
# Raise toward 16 MiB (16777216) only on very high bandwidth-delay-product
# links; must be within 262144 (256 KiB) – 16777216 (16 MiB).
# BEAMD_YAMUX_STREAM_WINDOW_BYTES=4194304
