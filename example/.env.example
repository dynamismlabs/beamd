# Copy this file to /etc/beamd/.env and fill in real values.
# docker compose picks it up automatically (do NOT commit the real one).

# Cloudflare API token with Zone:DNS:Edit, scoped to your beam zone.
# Create at: Cloudflare dashboard → My Profile → API Tokens → Create Token.
BEAMD_DNS_PROVIDER_CREDS=your-cloudflare-api-token-here

# Edge yamux per-stream receive window in bytes (default 4 MiB = 4194304).
# Raise toward 16 MiB (16777216) only on very high bandwidth-delay-product
# links; must be within 262144 (256 KiB) – 16777216 (16 MiB).
# BEAMD_YAMUX_STREAM_WINDOW_BYTES=4194304

# Part B tunnel transport. True is the permanent compiled/self-hosted default
# and edge kill switch. A hosted deployment explicitly sets false only after
# its qualification and production pilot pass. Changing it requires a restart.
BEAMD_DISABLE_QUIC=true
# BEAMD_LISTEN_QUIC=:443

# Conservative single-user capacity defaults. The 4 MiB yamux window multiplied
# by max_streams_total must remain <= 512 MiB.
# BEAMD_MAX_STREAMS_PER_SESSION=64
# BEAMD_MAX_STREAMS_TOTAL=128
# BEAMD_MAX_PRE_AUTH_SESSIONS=32
# BEAMD_MAX_SESSIONS_TOTAL=8

# Recommended for the documented 2 GiB edge VM/container.
GOMEMLIMIT=1400MiB

# Agent-side selection belongs in the environment that starts/reloads the local
# agent. Self-hosted/token and legacy accounts default to tcp; hosted/session
# accounts default to auto. This override wins over either product default.
# BEAMD_TRANSPORT=tcp
